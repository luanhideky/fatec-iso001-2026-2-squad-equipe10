flowchart LR

    SEN[Sensores IoT]
    USER[Operador / Gestor]

    subgraph EDGE["Ambiente Industrial"]
        GW[Gateway IoT]
    end

    subgraph HOST["Servidor Linux / VM"]
        APP[Aplicacao Web / Dashboard]
        API[API - Processo / Servico]
        COL[Servico de Coleta - Processo]
        PROC[Servico de Processamento - Processo]
        ALT[Servico de Alertas - Processo]
        LOG[Logs e Monitoramento]
        FS[(Filesystem / Volume de Logs)]
    end

    subgraph DATA["Servidor de Dados"]
        DB[(Banco de Dados)]
        BK[(Backup)]
    end

    SEN -->|Dados dos sensores| GW
    GW -->|Rede / Socket| COL

    COL --> PROC
    PROC --> DB
    PROC --> ALT

    USER --> APP
    APP --> API
    API --> DB

    COL --> LOG
    PROC --> LOG
    API --> LOG
    ALT --> LOG

    LOG --> FS
    DB --> BK
